#!/bin/sh
# Antes de qualquer push (deploy), salva um backup completo do Firestore no Google Drive.
# Se o backup falhar, o push é cancelado — nenhum deploy sai sem backup.
echo "▶ Backup do Firestore antes do push para '$1'..."
if ! npm run --silent backup:drive; then
  echo "✗ Backup falhou — push CANCELADO. Verifique se o Google Drive (G:) está disponível."
  exit 1
fi
