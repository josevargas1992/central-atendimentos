{
  "name": "central-atendimentos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backup": "node scripts/backup-firestore.mjs",
    "restore": "node scripts/restore-firestore.mjs",
    "backup:drive": "node scripts/backup-firestore.mjs --out=\"G:/Meu Drive/Backups/Central de Atendimentos\" --with-code",
    "test": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-central-testes \"node --test tests/*.test.mjs\"",
    "dev:seguro": "firebase emulators:exec --only firestore --project demo-central \"node scripts/dev-seguro.mjs\"",
    "dev:seguro:rapido": "firebase emulators:exec --only firestore --project demo-central \"node scripts/dev-seguro.mjs --sem-backup\""
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-tools": "15.30.2",
    "vite": "^5.4.2"
  }
}
